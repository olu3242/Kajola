# ──────────────────────────────────────────────────────────────────────────────
# Kajola — Environment Variables
# Copy this file to .env and fill in your values.
# ⚠️  NEVER commit .env to git — it contains real credentials.
# ──────────────────────────────────────────────────────────────────────────────

# ── Supabase ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=                      # Settings → API → Project URL
NEXT_PUBLIC_SUPABASE_ANON_KEY=                 # Settings → API → anon public key
SUPABASE_SERVICE_ROLE_KEY=                     # Settings → API → service_role key (⚠️ server-only)
SUPABASE_JWT_SECRET=                           # Settings → API → JWT secret
SUPABASE_DB_PASSWORD=                          # Settings → Database → Database password
SUPABASE_PROJECT_REF=                          # Project reference ID (from project URL)
SUPABASE_ACCESS_TOKEN=                         # Account → Access Tokens (for CI deploy)

# ── App URLs ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=                           # e.g. https://app.yourplatform.com
EXPO_PUBLIC_APP_URL=                           # Same as APP_URL for Expo deep links

# ── Payments — Paystack (primary, NGN / Ghana) ────────────────────────────────
PAYSTACK_SECRET_KEY=                           # Paystack Dashboard → Settings → API Keys
PAYSTACK_PUBLIC_KEY=                           # Paystack Dashboard → Settings → API Keys
PAYSTACK_WEBHOOK_SECRET=                       # Paystack Dashboard → Settings → Webhooks (hash)
WEB_PAYMENT_CALLBACK_URL=                      # e.g. https://app.yourplatform.com/payment/callback

# ── Payments — Flutterwave (pan-Africa fallback) ──────────────────────────────
FLUTTERWAVE_SECRET_KEY=                        # Flutterwave Dashboard → Settings → API Keys
FLUTTERWAVE_PUBLIC_KEY=                        # Flutterwave Dashboard → Settings → API Keys
FLUTTERWAVE_WEBHOOK_HASH=                      # Flutterwave Dashboard → Webhooks → Secret hash

# ── Payments — M-Pesa Daraja (Kenya / East Africa — C2B + B2C) ────────────────
MPESA_CONSUMER_KEY=                            # Safaricom Developer Portal → App → Consumer key
MPESA_CONSUMER_SECRET=                         # Safaricom Developer Portal → App → Consumer secret
MPESA_SHORTCODE=                               # Paybill or till number (from Safaricom)
MPESA_PASSKEY=                                 # STK Push passkey (from Safaricom after shortcode activation)
MPESA_CALLBACK_URL=                            # e.g. https://[project-ref].supabase.co/functions/v1/webhooks-daraja
MPESA_CALLBACK_SECRET=                         # Self-generated HMAC secret (32-byte hex) for callback verification
MPESA_B2C_INITIATOR=                           # B2C initiator username (from Safaricom)
MPESA_B2C_SECURITY_CRED=                       # B2C security credential (encrypted initiator password, from Safaricom)
MPESA_B2C_TIMEOUT_URL=                         # e.g. https://[project-ref].supabase.co/functions/v1/webhooks-daraja/timeout
MPESA_B2C_RESULT_URL=                          # e.g. https://[project-ref].supabase.co/functions/v1/webhooks-daraja/b2c-result
MPESA_ENV=                                     # "sandbox" or "production"

# ── Payments — MTN Mobile Money (Ghana GHS / Cameroon XAF) ───────────────────
MTN_MNO_SUBSCRIPTION_KEY=                      # MTN MoMo Developer Portal → Subscriptions → Primary key
MTN_MNO_API_USER=                              # UUID generated on MTN Developer Portal (sandbox) or assigned (prod)
MTN_MNO_API_KEY=                               # Generated from MTN MoMo API user endpoint
MTN_MNO_TARGET_ENV=                            # "sandbox" or "mtn-gh" / "mtn-cm" (production)
MTN_MNO_CALLBACK_URL=                          # e.g. https://[project-ref].supabase.co/functions/v1/webhooks-mtn
MTN_MNO_CALLBACK_SECRET=                       # Self-generated HMAC secret for callback verification

# ── Payments — Orange Money (Côte d'Ivoire XOF / Senegal) ────────────────────
ORANGE_CLIENT_ID=                              # Orange Developer Portal → App → Client ID
ORANGE_CLIENT_SECRET=                          # Orange Developer Portal → App → Client secret
ORANGE_MERCHANT_KEY=                           # Orange merchant key (from Orange Money business account)
ORANGE_CALLBACK_URL=                           # e.g. https://[project-ref].supabase.co/functions/v1/webhooks-orange
ORANGE_CALLBACK_SECRET=                        # Self-generated HMAC secret for callback verification
ORANGE_ENV=                                    # "sandbox" or "production"

# ── Notifications — Termii (primary SMS/OTP — West Africa: NG, GH, CI) ────────
TERMII_API_KEY=                                # Termii Dashboard → Settings → API Keys
TERMII_SENDER_ID=                              # Approved sender ID (3–11 chars, letters only)

# ── Notifications — Africa's Talking (East Africa: KE, UG, TZ, RW, ET) ───────
AT_API_KEY=                                    # Africa's Talking Dashboard → Settings → API Key
AT_USERNAME=                                   # Africa's Talking app username (or "sandbox" for dev)
AT_SENDER_ID=                                  # Approved alphanumeric sender ID (requires AT approval, 3–5 days)
AT_USSD_SHORTCODE=                             # USSD shortcode, e.g. *384# (from Africa's Talking)

# ── Notifications — Twilio (WhatsApp OTP fallback + rich notifications) ────────
TWILIO_ACCOUNT_SID=                            # Twilio Console → Account → Account SID
TWILIO_AUTH_TOKEN=                             # Twilio Console → Account → Auth Token
TWILIO_PHONE_NUMBER=                           # Twilio SMS/WhatsApp-enabled number, e.g. +12025551234
TWILIO_WHATSAPP_FROM=                          # WhatsApp-enabled number, e.g. whatsapp:+14155238886

# ── Maps ──────────────────────────────────────────────────────────────────────
GOOGLE_MAPS_API_KEY=                           # Google Cloud Console → APIs & Services → Credentials (restrict by origin/IP)

# ── Mobile Push ───────────────────────────────────────────────────────────────
EXPO_ACCESS_TOKEN=                             # expo.dev → Account → Access Tokens

# ── CDN / Edge ────────────────────────────────────────────────────────────────
CLOUDFLARE_ZONE_ID=                            # Cloudflare Dashboard → Domain → Zone ID (bottom right)
CLOUDFLARE_API_TOKEN=                          # Cloudflare Dashboard → My Profile → API Tokens (Zone:Edit)

# ── Edge Function config ──────────────────────────────────────────────────────
SUPABASE_FUNCTIONS_URL=                        # https://[project-ref].supabase.co/functions/v1
APP_ENV=                                       # "development" | "staging" | "production"

# ── Kajola Generator (AI architecture generation) ─────────────────────────────
ANTHROPIC_API_KEY=                             # console.anthropic.com → API Keys (⚠️ server-only, never expose to client)
