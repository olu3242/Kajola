{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "lib": ["dom", "dom.iterable", "es2020"],
    "allowJs": false,
    "skipLibCheck": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "moduleResolution": "node",
    "ignoreDeprecations": "5.0",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "preserve",
    "baseUrl": ".",
    "paths": {
      "@kajola/ui":          ["packages/ui/src"],
      "@kajola/api":         ["packages/api/src"],
      "@kajola/db":          ["packages/db/src"],
      "@kajola/automation":  ["packages/automation/src"],
      "@kajola/contracts":   ["packages/contracts/src"],
      "@kajola/runtime-os":  ["packages/runtime-os/src"],
      "@kajola/workflow-os": ["packages/workflow-os/src"],
      "@kajola/agent-os":    ["packages/agent-os/src"]
    }
  },
  "include": ["packages/**/*", "apps/**/*"],
  "references": [
    { "path": "packages/ui" },
    { "path": "packages/api" },
    { "path": "packages/db" },
    { "path": "packages/automation" }
  ]
}
